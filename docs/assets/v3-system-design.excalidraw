      "y": 580,
      "width": 420,
      "height": 205,
      "text": "TaskSpec\n{\n  entity_id: CIK...\n  period: FY2024\n  as_of: request_received_at\n  formula_id: operating_income_margin\n  evidence_needs: [operating_income, revenue]\n  budget: calls • tokens • $ • deadline\n  control_plane: immutable\n  enforced_by: every_stage\n}",
